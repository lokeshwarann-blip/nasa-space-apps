# Application Configuration
PROJECT_NAME="NASA Space Apps - Astronaut Health Monitor"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=false
LOG_LEVEL="INFO"
API_V1_PREFIX="/api/v1"

# Database Configuration (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="CHANGE_ME_IN_PRODUCTION"
POSTGRES_DB="astronaut_health"
# DATABASE_URL can be set explicitly or generated automatically from POSTGRES_* settings
# DATABASE_URL="postgresql+asyncpg://postgres:CHANGE_ME_IN_PRODUCTION@localhost:5432/astronaut_health"

# Security & Authentication (Required: minimum 32 characters in production)
SECRET_KEY="CHANGE_ME_IN_PRODUCTION_SECRET_KEY_MIN_32_CHARS"
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM="HS256"
